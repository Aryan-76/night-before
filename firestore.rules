rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.createdAt is timestamp;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'ownerId', 'fileUrl', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.fileUrl is string && data.fileUrl.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidDiscussion(data) {
      return data.keys().hasAll(['content', 'authorId', 'createdAt']) &&
             data.content is string && data.content.size() <= 2000 &&
             data.authorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // Collection Matches
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'survivalScore']);
    }

    match /notes/{noteId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(incoming());
      allow update: if isSignedIn() && isValidNote(incoming()) && (
        isOwner(existing().ownerId) || 
        incoming().diff(existing()).affectedKeys().hasOnly(['views', 'likes'])
      );
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    match /discussions/{discussionId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidId(discussionId) && isValidDiscussion(incoming());
      allow update: if isSignedIn() && isValidDiscussion(incoming()) && (
        isOwner(existing().authorId) || 
        incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'downvotes'])
      );
      allow delete: if isSignedIn() && isOwner(existing().authorId);
    }
  }
}
